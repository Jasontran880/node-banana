# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# Within each project, commit metadata (.json) plus the inputs/ and outputs/
# folders. Everything else — generated media (generations/), archives, and any
# loose scratch files — stays out of the commit.
/projects/**
!/projects/**/
!/projects/**/*.json
!/projects/**/inputs/**
!/projects/**/outputs/**

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# renders
renders/

# logs
logs/*.json

# .claude
.claude/

# planning docs
.planning/

# agents
.agents/

.superset/
